#version 450
#ifdef FH6_FP32
#define REAL float
#define RVEC3 vec3
#else
#extension GL_ARB_gpu_shader_fp64 : require
#define REAL double
#define RVEC3 dvec3
#endif
#extension GL_GOOGLE_include_directive : require
// polish_hard_tiled.comp — TILED HARD (binary inside) composite. One thread per PIXEL,
// walks ALL shapes in order with a local running composite. Mirrors engine.polishHardLoss's
// render; ONE dispatch, ZERO barriers. No below snapshot (hard loss is the shipped
// deliverable render; backward never reads a hard below). Shares the tiled-forward DSL/set
// — binding 4 (below) and 6 (boff) are bound but unused here.

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly  buffer Pb { float Pbuf[]; };
layout(std430, binding = 1) readonly  buffer Cb { float Cbuf[]; };
layout(std430, binding = 2) readonly  buffer Kb { int    Kbuf[]; };
layout(std430, binding = 3) writeonly buffer Rb { float  render[]; };
layout(std430, binding = 5) readonly  buffer Xb { int    bbx[]; };
layout(std430, binding = 7) readonly  buffer Ab { float  base[]; };
layout(std430, binding = 8) readonly  buffer Tb { int    tileOff[]; };
layout(std430, binding = 9) readonly  buffer Lb { int    tileList[]; };
layout(std430, binding = 10) readonly buffer MA { float maskAtlas[]; };
layout(std430, binding = 11) readonly buffer MM { int   maskMeta[]; };
layout(push_constant) uniform PC { int n, w, h, ste; float tau; int tilesX, tile, binned; } pc;
#include "mask_common.glsl"
#include "polish_common.glsl"

void main() {
    int idx = int(gl_GlobalInvocationID.x);
    if (idx >= pc.w * pc.h) return;
    int x = idx % pc.w, y = idx / pc.w, p = idx * 4;
    float ar = base[p], ag = base[p + 1], ab = base[p + 2], aa = base[p + 3];
    int lo = 0, hi = pc.n;
    if (pc.binned != 0) { int t = (y / pc.tile) * pc.tilesX + (x / pc.tile); lo = tileOff[t]; hi = tileOff[t + 1]; }
    for (int ti = lo; ti < hi; ti++) {
        int si = (pc.binned != 0) ? tileList[ti] : ti;
        int bx0 = bbx[si * 4], by0 = bbx[si * 4 + 1], bx1 = bbx[si * 4 + 2], by1 = bbx[si * 4 + 3];
        if (x < bx0 || x > bx1 || y < by0 || y > by1) continue;
        int kind = Kbuf[si];
        float P[6]; for (int k = 0; k < 6; k++) P[k] = Pbuf[si * 6 + k];
        float a = clamp(Cbuf[si * 4 + 3], 0.0, 1.0);
        if (isGradKind(kind)) { // per-pixel falloff, exactly as the deliverable render composites it
            float cov = gradCovAny(kind, P, x, y);
            if (cov <= 0.0) continue;
            a *= cov;
        } else if (!insideShape(kind, P, x, y)) {
            continue;
        }
        float ia = 1.0 - a;
        float R = Cbuf[si * 4 + 0], G = Cbuf[si * 4 + 1], B = Cbuf[si * 4 + 2];
        ar = ar * ia + R * a; ag = ag * ia + G * a; ab = ab * ia + B * a; aa = aa * ia + a;
    }
    render[p] = ar; render[p + 1] = ag; render[p + 2] = ab; render[p + 3] = aa;
}
