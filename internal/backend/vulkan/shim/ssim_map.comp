#version 450
#extension GL_ARB_gpu_shader_fp64 : require
// ssim_map.comp — per valid 8×8 window: vertical 8-sums of the h-pass, the SSIM pieces,
// Σ(1−S) into the workgroup partial (NO atomics — host sums partials in fixed order); when
// pc.writeG != 0 also the per-window moment-gradients for the backward (engine
// ssimState.adjoint / shim.cu ssMapReduce, same formulas + loop order).

layout(local_size_x = 256) in;
layout(std430, binding = 3) readonly buffer Hb { double hsum[]; };
layout(std430, binding = 4) readonly buffer Mb { double my[]; };
layout(std430, binding = 5)          buffer Gb { double gm[]; };
layout(std430, binding = 8)          buffer Pb { double parts[]; };
layout(push_constant) uniform PC { int w, h, mw, mh, writeG; float lambda; } pc;

shared double sh[256];

void main() {
    int nwin = pc.mw * pc.mh;
    int hp = pc.mw * pc.h;
    double acc = 0.0LF;
    for (int i = int(gl_GlobalInvocationID.x); i < nwin; i += int(gl_NumWorkGroups.x) * 256) {
        int gy = i / pc.mw, gx = i % pc.mw;
        double sx = 0.0LF, sxx = 0.0LF, sxy = 0.0LF;
        for (int k = 0; k < 8; k++) {
            int row = (gy + k) * pc.mw;
            sx += hsum[row + gx];
            sxx += hsum[hp + row + gx];
            sxy += hsum[2 * hp + row + gx];
        }
        double mx = sx * 0.015625LF, mxx = sxx * 0.015625LF, mxy = sxy * 0.015625LF;
        double m2 = my[i], m2y = my[nwin + i];
        double a1 = 2.0LF * mx * m2 + 0.0001LF;
        double a2 = 2.0LF * (mxy - mx * m2) + 0.0009LF;
        double b1 = mx * mx + m2 * m2 + 0.0001LF;
        double b2 = (mxx - mx * mx) + (m2y - m2 * m2) + 0.0009LF;
        double s = (a1 * a2) / (b1 * b2);
        acc += 1.0LF - s;
        if (pc.writeG != 0) {
            double denom = b1 * b2;
            double dsdmx = 2.0LF * m2 * (a2 - a1) / denom - s * 2.0LF * mx * (1.0LF / b1 - 1.0LF / b2);
            gm[i] = -dsdmx;
            gm[nwin + i] = s / b2;
            gm[2 * nwin + i] = -2.0LF * a1 / denom;
        }
    }
    sh[gl_LocalInvocationID.x] = acc;
    barrier();
    for (uint st = 128; st > 0; st >>= 1) {
        if (gl_LocalInvocationID.x < st) sh[gl_LocalInvocationID.x] += sh[gl_LocalInvocationID.x + st];
        barrier();
    }
    if (gl_LocalInvocationID.x == 0) parts[gl_WorkGroupID.x] = sh[0];
}
