#version 450
#ifdef FH6_FP32
#define REAL float
#define RVEC3 vec3
#else
#extension GL_ARB_gpu_shader_fp64 : require
#define REAL double
#define RVEC3 dvec3
#endif
// ssim_map.comp — per valid 8×8 window: vertical 8-sums of the h-pass, the SSIM pieces,
// Σ(1−S) into the workgroup partial (NO atomics — host sums partials in fixed order); when
// pc.writeG != 0 also the per-window moment-gradients for the backward (engine
// ssimState.adjoint / shim.cu ssMapReduce, same formulas + loop order).

layout(local_size_x = 256) in;
layout(std430, binding = 3) readonly buffer Hb { REAL hsum[]; };
layout(std430, binding = 4) readonly buffer Mb { REAL my[]; };
layout(std430, binding = 5)          buffer Gb { REAL gm[]; };
layout(std430, binding = 8)          buffer Pb { REAL parts[]; };
layout(push_constant) uniform PC { int w, h, mw, mh, writeG; float lambda; } pc;

shared REAL sh[256];

void main() {
    int nwin = pc.mw * pc.mh;
    int hp = pc.mw * pc.h;
    REAL acc = REAL(0.0);
    for (int i = int(gl_GlobalInvocationID.x); i < nwin; i += int(gl_NumWorkGroups.x) * 256) {
        int gy = i / pc.mw, gx = i % pc.mw;
        REAL sx = REAL(0.0), sxx = REAL(0.0), sxy = REAL(0.0);
        for (int k = 0; k < 8; k++) {
            int row = (gy + k) * pc.mw;
            sx += hsum[row + gx];
            sxx += hsum[hp + row + gx];
            sxy += hsum[2 * hp + row + gx];
        }
        REAL mx = sx * REAL(0.015625), mxx = sxx * REAL(0.015625), mxy = sxy * REAL(0.015625);
        REAL m2 = my[i], m2y = my[nwin + i];
        REAL a1 = REAL(2.0) * mx * m2 + REAL(0.0001);
        REAL a2 = REAL(2.0) * (mxy - mx * m2) + REAL(0.0009);
        REAL b1 = mx * mx + m2 * m2 + REAL(0.0001);
        REAL b2 = (mxx - mx * mx) + (m2y - m2 * m2) + REAL(0.0009);
        REAL s = (a1 * a2) / (b1 * b2);
        acc += REAL(1.0) - s;
        if (pc.writeG != 0) {
            REAL denom = b1 * b2;
            REAL dsdmx = REAL(2.0) * m2 * (a2 - a1) / denom - s * REAL(2.0) * mx * (REAL(1.0) / b1 - REAL(1.0) / b2);
            gm[i] = -dsdmx;
            gm[nwin + i] = s / b2;
            gm[2 * nwin + i] = -REAL(2.0) * a1 / denom;
        }
    }
    sh[gl_LocalInvocationID.x] = acc;
    barrier();
    for (uint st = 128; st > 0; st >>= 1) {
        if (gl_LocalInvocationID.x < st) sh[gl_LocalInvocationID.x] += sh[gl_LocalInvocationID.x + st];
        barrier();
    }
    if (gl_LocalInvocationID.x == 0) parts[gl_WorkGroupID.x] = sh[0];
}
