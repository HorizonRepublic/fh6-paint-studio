#version 450
#extension GL_ARB_gpu_shader_fp64 : require
// ssim_adj.comp — vertical box-correlation + per-pixel combine: adj(q) = (T1 + 2x·T2 + y·T3)/N
// (engine ssimState.adjoint / shim.cu ssAdjKernel). Feeds the dcinit dC luma seed (binding 11
// of the shared polish set).

layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer Tb { float tl[]; };
layout(std430, binding = 2) readonly buffer Lb { float rl[]; };
layout(std430, binding = 6) readonly buffer HGb { double hg[]; };
layout(std430, binding = 7)          buffer Ab { double adj[]; };
layout(push_constant) uniform PC { int w, h, mw, mh, writeG; float lambda; } pc;

void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= pc.w * pc.h) return;
    int qy = i / pc.w, qx = i % pc.w;
    int p0 = qy - 7; if (p0 < 0) p0 = 0;
    int p1 = qy; if (p1 > pc.mh - 1) p1 = pc.mh - 1;
    int whm = pc.w * pc.mh;
    double t1 = 0.0LF, t2 = 0.0LF, t3 = 0.0LF;
    for (int py = p0; py <= p1; py++) {
        int row = py * pc.w;
        t1 += hg[row + qx];
        t2 += hg[whm + row + qx];
        t3 += hg[2 * whm + row + qx];
    }
    adj[i] = (t1 + 2.0LF * double(rl[i]) * t2 + double(tl[i]) * t3) * 0.015625LF;
}
