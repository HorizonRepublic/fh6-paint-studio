#version 450
#ifdef FH6_FP32
#define REAL float
#define RVEC3 vec3
#else
#extension GL_ARB_gpu_shader_fp64 : require
#define REAL double
#define RVEC3 dvec3
#endif
// polish_dcinit.comp — dC[p] = 2*weight*(render-target) per channel, the backward
// pass seed (dLoss/dC_final). Mirrors the head of engine.polishBackward.
// pc.oklab = 2*weight*J^T*dLab for the colour channels (engine.okLabPixelDC).

layout(local_size_x = 256) in;
layout(std430, binding = 3) readonly buffer Rb { float render[]; };
layout(std430, binding = 5)          buffer Db { float dC[]; };
layout(std430, binding = 8) readonly buffer Tb { float target[]; };
layout(std430, binding = 9) readonly buffer Wb { float weightb[]; };
layout(std430, binding = 10) readonly buffer Fb { REAL feAdj[]; };
layout(std430, binding = 11) readonly buffer Sb { REAL ssimAdj[]; };
layout(std430, binding = 12) readonly buffer Eb { REAL eagleAdj[]; };
layout(push_constant) uniform PC {
    int shapeIdx, w, h, xMin, yMin, xMax, yMax, boff, ste, npix; float tau; int oklab; float feLambda; float ssimLambda; float eagleLambda; float ldLambda;
} pc;

// dcbrt — REAL cube root via float seed + 2 Newton steps (see polish_loss.comp).
REAL dcbrt(REAL x) {
    if (x < 1e-30) return REAL(0.0);
    REAL c = REAL(pow(float(x), 0.33333334));
    c -= (c * c * c - x) / (REAL(3.0) * c * c);
    c -= (c * c * c - x) / (REAL(3.0) * c * c);
    return c;
}

// dcbrtSq — cbrt(max(x,eps))^2, the clamped cube-root-derivative denominator (engine.cbrtSq).
REAL dcbrtSq(REAL x) {
    if (x < REAL(1e-7)) x = REAL(1e-7);
    REAL c = dcbrt(x);
    return c * c;
}

void main() {
    int idx = int(gl_GlobalInvocationID.x);
    if (idx >= pc.npix) return;
    int p = idx * 4;
    // False-edge + SSIM terms (engine falseedge.go / ssimterm.go): both chain through the luma
    // coefficients into the dC RGB seeds; alpha carries no luma.
    REAL feR = REAL(0.0), feG = REAL(0.0), feB = REAL(0.0);
    if (pc.feLambda > 0.0 || pc.ssimLambda > 0.0 || pc.eagleLambda > 0.0 || pc.ldLambda > 0.0) {
        REAL a = REAL(0.0);
        // feAdj carries BOTH the false-edge and lost-detail scatter, already lambda-weighted by
        // fe_dir (the two lambdas differ, so they cannot be applied here). Do not scale it again.
        if (pc.feLambda > 0.0 || pc.ldLambda > 0.0) a = feAdj[idx];
        if (pc.ssimLambda > 0.0) a += REAL(pc.ssimLambda) * ssimAdj[idx];
        if (pc.eagleLambda > 0.0) a += REAL(pc.eagleLambda) * eagleAdj[idx];
        feR = a * REAL(0.299); feG = a * REAL(0.587); feB = a * REAL(0.114);
    }
    if (pc.oklab != 0) {
        REAL wt = REAL(weightb[idx]);
        REAL rr = REAL(render[p]), rg = REAL(render[p + 1]), rb = REAL(render[p + 2]);
        REAL l = REAL(0.4122214708) * rr + REAL(0.5363325363) * rg + REAL(0.0514459929) * rb;
        REAL m = REAL(0.2119034982) * rr + REAL(0.6806995451) * rg + REAL(0.1073969566) * rb;
        REAL s = REAL(0.0883024619) * rr + REAL(0.2817188376) * rg + REAL(0.6299787005) * rb;
        REAL lc = dcbrt(l), mc = dcbrt(m), sc = dcbrt(s);
        REAL rL = REAL(0.2104542553) * lc + REAL(0.7936177850) * mc - REAL(0.0040720468) * sc;
        REAL rA = REAL(1.9779984951) * lc - REAL(2.4285922050) * mc + REAL(0.4505937099) * sc;
        REAL rB = REAL(0.0259040371) * lc + REAL(0.7827717662) * mc - REAL(0.8086757660) * sc;
        REAL tr = REAL(target[p]), tg = REAL(target[p + 1]), tb = REAL(target[p + 2]);
        REAL l2 = REAL(0.4122214708) * tr + REAL(0.5363325363) * tg + REAL(0.0514459929) * tb;
        REAL m2 = REAL(0.2119034982) * tr + REAL(0.6806995451) * tg + REAL(0.1073969566) * tb;
        REAL s2 = REAL(0.0883024619) * tr + REAL(0.2817188376) * tg + REAL(0.6299787005) * tb;
        REAL lc2 = dcbrt(l2), mc2 = dcbrt(m2), sc2 = dcbrt(s2);
        REAL tL = REAL(0.2104542553) * lc2 + REAL(0.7936177850) * mc2 - REAL(0.0040720468) * sc2;
        REAL tA = REAL(1.9779984951) * lc2 - REAL(2.4285922050) * mc2 + REAL(0.4505937099) * sc2;
        REAL tB = REAL(0.0259040371) * lc2 + REAL(0.7827717662) * mc2 - REAL(0.8086757660) * sc2;
        REAL dL = REAL(2.0) * wt * (rL - tL), dA = REAL(2.0) * wt * (rA - tA), dB = REAL(2.0) * wt * (rB - tB);
        REAL gl = dL * REAL(0.2104542553) + dA * REAL(1.9779984951) + dB * REAL(0.0259040371);
        REAL gm = dL * REAL(0.7936177850) - dA * REAL(2.4285922050) + dB * REAL(0.7827717662);
        REAL gs = -dL * REAL(0.0040720468) + dA * REAL(0.4505937099) - dB * REAL(0.8086757660);
        gl /= REAL(3.0) * dcbrtSq(l);
        gm /= REAL(3.0) * dcbrtSq(m);
        gs /= REAL(3.0) * dcbrtSq(s);
        dC[p + 0] = float(gl * REAL(0.4122214708) + gm * REAL(0.2119034982) + gs * REAL(0.0883024619) + feR);
        dC[p + 1] = float(gl * REAL(0.5363325363) + gm * REAL(0.6806995451) + gs * REAL(0.2817188376) + feG);
        dC[p + 2] = float(gl * REAL(0.0514459929) + gm * REAL(0.1073969566) + gs * REAL(0.6299787005) + feB);
        dC[p + 3] = float(REAL(2.0) * wt * (REAL(render[p + 3]) - REAL(target[p + 3])));
        return;
    }
    REAL wt = REAL(weightb[idx]);
    dC[p + 0] = float(REAL(2.0) * wt * (REAL(render[p + 0]) - REAL(target[p + 0])) + feR);
    dC[p + 1] = float(REAL(2.0) * wt * (REAL(render[p + 1]) - REAL(target[p + 1])) + feG);
    dC[p + 2] = float(REAL(2.0) * wt * (REAL(render[p + 2]) - REAL(target[p + 2])) + feB);
    dC[p + 3] = float(REAL(2.0) * wt * (REAL(render[p + 3]) - REAL(target[p + 3])));
}
