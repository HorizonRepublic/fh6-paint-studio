#version 450
// gen.comp — on-device random candidate generator. Faithful port of shim.cu genKernel:
// the SAME counter-based wanghash RNG (uf), so generated candidates are bit-identical to
// the CUDA backend (the on-device search is validated by end-to-end SSE, not golden-diff).
// Writes n candidates to the 11-float wire format. Kinds: 0=ellipse 1=rect 2=triangle.

layout(local_size_x = 256) in;
layout(std430, binding = 0) writeonly buffer Sc { float scand[]; };
layout(std430, binding = 1) readonly  buffer Kk { float kinds[]; };
layout(std430, binding = 2) readonly  buffer Kc { float kindCDF[]; };
layout(std430, binding = 3) readonly  buffer Gc { float gridCDF[]; };
layout(std430, binding = 4) readonly  buffer Or { float orient[]; };
layout(std430, binding = 5) readonly  buffer Bd { float boundDist[]; };
layout(std430, binding = 6) readonly  buffer Kg { float kindGate[]; };
layout(std430, binding = 7) readonly  buffer Rg { float rampGlow[]; };
layout(std430, binding = 8) readonly  buffer Pm { float prop[]; };      // proposal map, (heads*8) planes
layout(std430, binding = 9) readonly  buffer Pk { float propKinds[]; }; // kind per head
layout(std430, binding = 10) readonly buffer Ch { float coh[]; };       // structure-tensor coherence
// Proposer config lives in a tiny SSBO, NOT the push-constant block: with these 11 words inline
// the PC was 164 bytes, past the 128-byte guaranteed maxPushConstantsSize — vkCreatePipelineLayout
// failed outright on AMD/most Intel (invisible on NVIDIA's 256). The values change at most once
// per proposer refresh, so a buffer costs nothing.
layout(std430, binding = 11) readonly buffer Cf {
    int cfg_hasProp; int cfg_propW; int cfg_propH; int cfg_propHeads; int cfg_propOff; int cfg_propConfGate;
    float cfg_propFrac; float cfg_propPatch; float cfg_propJitter; float cfg_propStride; float cfg_propConfTau; // propStride: canvas pixels per map cell
};
layout(push_constant) uniform PC {
    uint seedLo, seedHi;
    int n, nKinds, gw, gh, W, H, allowAlpha, hasOrient, hasBound, hasGate, hasRampGlow, bigKinds, bigKind, hasCoh;
    float maxR, alphaMin, aspectMax, boundPad, boundMix, canvasPad, glowTau, glowProb, rampThresh, rampTau, rampProb, bigTau, bigProb, aspectCap;
} pc;

uint wanghash(uint x) { x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16; return x; }
float uf(uint i, inout uint ctr) {
    uint a = pc.seedLo ^ 0x9e3779b9u, b = pc.seedHi;
    ctr += 1u;
    uint h = wanghash(a + wanghash(i + 0x85ebca6bu) + wanghash((b ^ ctr) * 0xc2b2ae35u));
    return float(h >> 8) * (1.0 / 16777216.0);
}
float clampf2(float v, float lo, float hi) { return v < lo ? lo : (v > hi ? hi : v); }

// clampExtentsD: shrink half-extents so the rotated bbox stays within [-pad,W+pad]x[-pad,H+pad].
void clampExtents(float cx, float cy, inout float a, inout float b, float thetaDeg, float W, float H, float pad) {
    float th = thetaDeg * 0.017453292519943295;
    float cs = cos(th), sn = sin(th);
    float hx = length(vec2(a * cs, b * sn));
    float hy = length(vec2(a * sn, b * cs));
    float allowX = max(1.0, min(cx, W - cx) + pad);
    float allowY = max(1.0, min(cy, H - cy) + pad);
    float scale = 1.0;
    if (hx > allowX) scale = min(scale, allowX / hx);
    if (hy > allowY) scale = min(scale, allowY / hy);
    if (scale < 1.0) { a *= scale; b *= scale; }
}

// propAt fetches parameter k of head hd at the proposal-map cell covering (cx, cy).
// propAt fetches parameter k of head hd for the location (cx, cy).
//
// The map is indexed by the TOP-LEFT cell of each pooled window, so the entry describing the window
// CENTRED on (cx, cy) sits propOff cells earlier in both axes. Reading it without that shift asks the
// network about a region offset from where the shape will actually land.
float propAt(int hd, int k, float cx, float cy) {
    int gx = clamp(int(cx / cfg_propStride) - cfg_propOff, 0, cfg_propW - 1);
    int gy = clamp(int(cy / cfg_propStride) - cfg_propOff, 0, cfg_propH - 1);
    return prop[(hd * 8 + k) * (cfg_propW * cfg_propH) + gy * cfg_propW + gx];
}

// proposeCandidate writes one network-proposed shape in the wire format and returns its kind.
// Units follow the training graph: offsets and extents are fractions of the patch the geometry is
// normalised against, and the angle arrives as a doubled-angle sin/cos pair (an ellipse at t and
// t+180 degrees is the same ellipse). Everything downstream is untouched -- the proposal is scored
// by the same exact eval as a random draw, which is why a weak network costs speed, never quality.
// jit returns a symmetric perturbation of magnitude ~cfg_propJitter. Without it every candidate that
// picks the same head at the same location is the SAME shape, so a batch of a thousand would carry
// only propHeads distinct proposals. The network supplies the eight modes; the jitter spreads a full
// batch around them, and the exact eval still decides which spread candidate actually wins.
float jit(int i, inout uint ctr) {
    return (uf(uint(i), ctr) - 0.5) * 2.0 * cfg_propJitter;
}

void proposeCandidate(int i, inout uint ctr, int base, float cx, float cy) {
    // Head by INDEX, not by lottery. The network's value is best-of-heads at a location: the heads
    // are trained winner-take-all, so each one specialises and any single head is mediocre on its
    // own. Drawing one at random per candidate throws that away -- measured as the proposer merely
    // matching random search in the engine while beating it comfortably in the simulator, where all
    // heads are always scored at every location.
    int hd = i % cfg_propHeads;
    int kind = int(propKinds[hd] + 0.5);
    float ps = cfg_propPatch;
    scand[base + 0] = float(kind);
    scand[base + 7] = 0.0; scand[base + 8] = 0.0; scand[base + 9] = 0.0;
    scand[base + 10] = propAt(hd, 6, cx, cy);
    if (kind == 2) {
        for (int v = 0; v < 3; v++) {
            scand[base + 1 + v * 2] = clampf2(cx + (propAt(hd, v * 2, cx, cy) + jit(i, ctr)) * ps, 0.0, float(pc.W - 1));
            scand[base + 2 + v * 2] = clampf2(cy + (propAt(hd, v * 2 + 1, cx, cy) + jit(i, ctr)) * ps, 0.0, float(pc.H - 1));
        }
        return;
    }
    float px = clampf2(cx + (propAt(hd, 0, cx, cy) + jit(i, ctr)) * ps, 0.0, float(pc.W - 1));
    float py = clampf2(cy + (propAt(hd, 1, cx, cy) + jit(i, ctr)) * ps, 0.0, float(pc.H - 1));
    float rx = max(1.0, (propAt(hd, 2, cx, cy) + jit(i, ctr)) * ps);
    float ry = max(1.0, (propAt(hd, 3, cx, cy) + jit(i, ctr)) * ps);
    float theta = degrees(0.5 * atan(propAt(hd, 4, cx, cy), propAt(hd, 5, cx, cy)));
    scand[base + 1] = px; scand[base + 2] = py;
    scand[base + 5] = theta; scand[base + 6] = 0.0;
    if (pc.canvasPad > 0.0) {
        float padPx = pc.canvasPad * min(float(pc.W), float(pc.H));
        clampExtents(px, py, rx, ry, theta, float(pc.W), float(pc.H), padPx);
    }
    scand[base + 3] = rx; scand[base + 4] = ry;
}

void main() {
    int stride = int(gl_NumWorkGroups.x * gl_WorkGroupSize.x);
    for (int i = int(gl_GlobalInvocationID.x); i < pc.n; i += stride) {
        uint ctr = 0u;
        int base = i * 11;
        // With the proposer on, consecutive candidates form GROUPS that share one centre, so the
        // group covers every head at that location. The centre draw is therefore keyed on the group
        // index; the per-candidate stream still diverges afterwards, which is what spreads the jitter.
        uint rid = (cfg_hasProp != 0 && cfg_propHeads > 0) ? uint(i / cfg_propHeads) : uint(i);
        float total = gridCDF[pc.gw * pc.gh - 1];
        float cx, cy;
        if (total <= 0.0) {
            cx = uf(rid, ctr) * float(pc.W);
            cy = uf(rid, ctr) * float(pc.H);
        } else {
            float u = uf(rid, ctr) * total;
            int lo = 0, hi = pc.gw * pc.gh - 1;
            while (lo < hi) { int mid = (lo + hi) >> 1; if (gridCDF[mid] < u) lo = mid + 1; else hi = mid; }
            int gx = lo % pc.gw, gy = lo / pc.gw;
            int x0 = gx * pc.W / pc.gw, x1 = (gx + 1) * pc.W / pc.gw;
            int y0 = gy * pc.H / pc.gh, y1 = (gy + 1) * pc.H / pc.gh;
            if (x1 <= x0) x1 = x0 + 1;
            if (y1 <= y0) y1 = y0 + 1;
            cx = float(x0) + uf(rid, ctr) * float(x1 - x0);
            cy = float(y0) + uf(rid, ctr) * float(y1 - y0);
        }
        cx = clampf2(cx, 0.0, float(pc.W - 1));
        cy = clampf2(cy, 0.0, float(pc.H - 1));
        // Region-gated proposals. Measured on img_9: the network is BETTER than the tuned search in
        // dark masses (-18.9 mean squared error) and clearly WORSE on contours (+97.7 on the top
        // decile of target gradient), winning on 48% of pixels overall. The two are complements, not
        // competitors: the engine's orientation map aligns candidates along target gradients, which
        // is exactly the edge behaviour the network lacks, while the network sees shadow detail the
        // linear-light score is blind to. So proposals run at full share in structureless cells and
        // fade out where the target has real structure.
        float pf = cfg_propFrac;
        if (cfg_hasProp != 0 && pc.hasGate != 0 && cfg_propConfGate == 0) {
            int gi = int(cy) * pc.W + int(cx);
            if (gi >= 0 && gi < pc.W * pc.H) pf *= 1.0 - clamp(kindGate[gi], 0.0, 1.0);
        }
        // Learned gate. The hand gate above asks what KIND OF REGION this is and fades the network
        // out where the target has structure -- a rule written from one image's win/loss split. The
        // network's own confidence head answers the narrower question directly: at this location, is
        // this head's proposal better than what a uniform draw would have found? Where it says no,
        // the candidate falls through to the random path, which costs nothing and cannot be worse.
        if (cfg_hasProp != 0 && cfg_propConfGate != 0 && cfg_propHeads > 0) {
            int hd = int(uint(i) % uint(cfg_propHeads));
            // The threshold is NOT zero by default for a measured reason: the head was trained
            // against the best of a handful of uniform draws, while the engine takes the best of
            // roughly two thousand. Its idea of "better than random" is therefore optimistic, and
            // the stronger the model gets the more places it wrongly claims. propConfTau raises the
            // bar back towards the baseline the engine actually offers.
            if (propAt(hd, 7, cx, cy) <= cfg_propConfTau) pf = 0.0;
        }
        if (cfg_hasProp != 0 && uf(uint(i), ctr) < pf) {
            proposeCandidate(i, ctr, base, cx, cy);
            continue;
        }
        float emaxR = pc.maxR;
        if (pc.hasBound != 0 && pc.boundMix > 0.0) {
            int bidx = int(cy) * pc.W + int(cx);
            if (bidx >= 0 && bidx < pc.W * pc.H) {
                float lim = boundDist[bidx] + pc.boundPad;
                if (lim < emaxR) emaxR = emaxR + (lim - emaxR) * pc.boundMix;
            }
        }
        float theta = uf(uint(i), ctr) * 360.0;
        float aspectMax = pc.aspectMax;
        if (pc.hasOrient != 0) {
            int idx = int(cy) * pc.W + int(cx);
            if (idx >= 0 && idx < pc.W * pc.H) {
                theta = orient[idx] + (uf(uint(i), ctr) * 40.0 - 20.0);
                // Anisotropy prior (engine genCandidate): the tensor's coherence narrows the jitter
                // and sets the elongation. It REPLACES aspectMax rather than widening it — the
                // preset's global value is applied everywhere today, including flat regions where
                // the seeding angle is noise.
                if (pc.hasCoh != 0 && pc.aspectCap > 1.0) {
                    float k = coh[idx];
                    theta = orient[idx] + (uf(uint(i), ctr) * 40.0 - 20.0) * (1.0 - 0.75 * k);
                    aspectMax = 1.0 + k * (pc.aspectCap - 1.0);
                }
            }
        }
        float alpha = 1.0;
        if (pc.allowAlpha != 0) alpha = pc.alphaMin + (1.0 - pc.alphaMin) * uf(uint(i), ctr);
        // region-gated kinds (engine kindGate.pick / shim.cu genKernel): the full pool only
        // with probability gate[centre], else ellipse (kind 0).
        int kind = int(kinds[pc.nKinds - 1] + 0.5);
        bool fullPool = true;
        if (pc.hasGate != 0) {
            int gidx = int(cy) * pc.W + int(cx);
            if (gidx >= 0 && gidx < pc.W * pc.H && uf(uint(i), ctr) >= kindGate[gidx]) {
                kind = 0; fullPool = false;
                // deep-smooth glow swap: a rimless glow where the target has no structure at all;
                // HOTTER (rampTau/rampProb) in genuine gradient zones (rampGlow[gidx] > rampThresh).
                float effTau = pc.glowTau, effProb = pc.glowProb;
                if (pc.hasRampGlow != 0 && rampGlow[gidx] > pc.rampThresh) { effTau = pc.rampTau; effProb = pc.rampProb; }
                if (kindGate[gidx] < effTau && uf(uint(i), ctr) < effProb) kind = 4;
            }
        }
        if (fullPool) {
            float ku = uf(uint(i), ctr) * kindCDF[pc.nKinds - 1];
            for (int k = 0; k < pc.nKinds; k++) {
                if (ku < kindCDF[k]) { kind = int(kinds[k] + 0.5); break; }
            }
        }
        scand[base + 0] = float(kind);
        scand[base + 7] = 0.0; scand[base + 8] = 0.0; scand[base + 9] = 0.0; scand[base + 10] = alpha;
        float padPx = pc.canvasPad * min(float(pc.W), float(pc.H));
        float bigThr = pc.bigTau * min(float(pc.W), float(pc.H));
        if (kind == 1) {
            float hw = 1.0 + uf(uint(i), ctr) * (emaxR - 1.0);
            float u2 = uf(uint(i), ctr);
            float hh = (aspectMax > 1.0) ? max(0.5, hw / (1.0 + u2 * (aspectMax - 1.0))) : 1.0 + u2 * (emaxR - 1.0);
            scand[base + 1] = cx; scand[base + 2] = cy; scand[base + 5] = theta; scand[base + 6] = 0.0;
            if (pc.canvasPad > 0.0) clampExtents(cx, cy, hw, hh, theta, float(pc.W), float(pc.H), padPx);
            scand[base + 3] = hw; scand[base + 4] = hh;
            // A rect's wire params ARE the glow's (cx, cy, half-extents, theta), so the swap is a
            // kind rewrite; see the ellipse branch for why size alone decides it.
            if (pc.bigKinds != 0 && pc.bigProb > 0.0 && sqrt(hw * hh) > bigThr &&
                uf(uint(i), ctr) < pc.bigProb) scand[base + 0] = float(pc.bigKind);
        } else if (kind == 2) {
            float rr = 4.0 + uf(uint(i), ctr) * (emaxR - 4.0);
            float vx1 = clampf2(cx + (-rr + 2.0 * rr * uf(uint(i), ctr)), 0.0, float(pc.W - 1));
            float vy1 = clampf2(cy + (-rr + 2.0 * rr * uf(uint(i), ctr)), 0.0, float(pc.H - 1));
            float vx2 = clampf2(cx + (-rr + 2.0 * rr * uf(uint(i), ctr)), 0.0, float(pc.W - 1));
            float vy2 = clampf2(cy + (-rr + 2.0 * rr * uf(uint(i), ctr)), 0.0, float(pc.H - 1));
            float vx3 = clampf2(cx + (-rr + 2.0 * rr * uf(uint(i), ctr)), 0.0, float(pc.W - 1));
            float vy3 = clampf2(cy + (-rr + 2.0 * rr * uf(uint(i), ctr)), 0.0, float(pc.H - 1));
            scand[base + 1] = vx1; scand[base + 2] = vy1; scand[base + 3] = vx2;
            scand[base + 4] = vy2; scand[base + 5] = vx3; scand[base + 6] = vy3;
            // A triangle has no glow-compatible parameterisation, so the swap re-emits the candidate
            // as the glow inscribed in its vertex box (0.7 of the half-extents ~ matches the covered
            // area). A big triangle's straight rims are the same contour artifact as a big ellipse's.
            float bx0 = min(min(vx1, vx2), vx3), bx1 = max(max(vx1, vx2), vx3);
            float by0 = min(min(vy1, vy2), vy3), by1 = max(max(vy1, vy2), vy3);
            float grx = max(2.0, 0.7 * 0.5 * (bx1 - bx0)), gry = max(2.0, 0.7 * 0.5 * (by1 - by0));
            if (pc.bigKinds != 0 && pc.bigProb > 0.0 && sqrt(grx * gry) > bigThr &&
                uf(uint(i), ctr) < pc.bigProb) {
                scand[base + 0] = float(pc.bigKind);
                scand[base + 1] = (vx1 + vx2 + vx3) / 3.0; scand[base + 2] = (vy1 + vy2 + vy3) / 3.0;
                scand[base + 3] = grx; scand[base + 4] = gry; scand[base + 5] = 0.0; scand[base + 6] = 0.0;
            }
        } else {
            float rx = 2.0 + uf(uint(i), ctr) * (emaxR - 2.0);
            float u2 = uf(uint(i), ctr);
            float ry = (aspectMax > 1.0) ? max(1.0, rx / (1.0 + u2 * (aspectMax - 1.0))) : 2.0 + u2 * (emaxR - 2.0);
            scand[base + 1] = cx; scand[base + 2] = cy; scand[base + 5] = theta; scand[base + 6] = 0.0;
            if (pc.canvasPad > 0.0) clampExtents(cx, cy, rx, ry, theta, float(pc.W), float(pc.H), padPx);
            scand[base + 3] = rx; scand[base + 4] = ry;
            // BIG-SHAPE glow swap (fp_set_big_glow): a LARGE ellipse is approximating broad shading,
            // and its rim is a long low-contrast closed contour the eye reads as an oval even where
            // Sobel-based false-edge barely charges it. The hardness gate above cannot catch this —
            // it asks whether the region has structure, not whether THIS shape is big enough for its
            // rim to become a contour. A glow carries the same footprint with no rim at all.
            if (kind == 0 && pc.bigProb > 0.0 && sqrt(rx * ry) > bigThr &&
                uf(uint(i), ctr) < pc.bigProb) scand[base + 0] = float(pc.bigKind);
        }
    }
}
