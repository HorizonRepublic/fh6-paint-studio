#version 450
#extension GL_ARB_gpu_shader_fp64 : require
// ssim_gh.comp — horizontal box-correlation of the moment-gradients: HG(y,qx) = Σ G(y,px),
// px ∈ [qx−7, qx] clamped to valid window columns, ascending (engine adjoint / shim.cu ssGH).

layout(local_size_x = 256) in;
layout(std430, binding = 5) readonly buffer Gb { double gm[]; };
layout(std430, binding = 6)          buffer HGb { double hg[]; };
layout(push_constant) uniform PC { int w, h, mw, mh, writeG; float lambda; } pc;

void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= pc.w * pc.mh) return;
    int gy = i / pc.w, qx = i % pc.w;
    int p0 = qx - 7; if (p0 < 0) p0 = 0;
    int p1 = qx; if (p1 > pc.mw - 1) p1 = pc.mw - 1;
    int nwin = pc.mw * pc.mh;
    int grow = gy * pc.mw;
    double t1 = 0.0LF, t2 = 0.0LF, t3 = 0.0LF;
    for (int px = p0; px <= p1; px++) {
        t1 += gm[grow + px];
        t2 += gm[nwin + grow + px];
        t3 += gm[2 * nwin + grow + px];
    }
    int whm = pc.w * pc.mh;
    hg[i] = t1;
    hg[whm + i] = t2;
    hg[2 * whm + i] = t3;
}
