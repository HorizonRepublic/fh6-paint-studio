#version 450
#ifdef FH6_FP32
#define REAL float
#define RVEC3 vec3
#else
#extension GL_ARB_gpu_shader_fp64 : require
#define REAL double
#define RVEC3 dvec3
#endif
// ssim_myinit.comp — target window means from the target's own h-pass (plane 0 = Σy,
// plane 1 = Σy²). Run ONCE at set-lambda on setT (engine newSSIMState / shim.cu ssMyInit).

layout(local_size_x = 256) in;
layout(std430, binding = 3) readonly buffer Hb { REAL hsum[]; };
layout(std430, binding = 4)          buffer Mb { REAL my[]; };
layout(push_constant) uniform PC { int w, h, mw, mh, writeG; float lambda; } pc;

void main() {
    int i = int(gl_GlobalInvocationID.x);
    int nwin = pc.mw * pc.mh;
    if (i >= nwin) return;
    int gy = i / pc.mw, gx = i % pc.mw;
    int hp = pc.mw * pc.h;
    REAL sy = REAL(0.0), syy = REAL(0.0);
    for (int k = 0; k < 8; k++) {
        int row = (gy + k) * pc.mw;
        sy += hsum[row + gx];
        syy += hsum[hp + row + gx];
    }
    my[i] = sy * REAL(0.015625);
    my[nwin + i] = syy * REAL(0.015625);
}
