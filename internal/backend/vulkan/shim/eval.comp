#version 450
#ifdef FH6_FP32
#define REAL float
#define RVEC3 vec3
#else
#extension GL_ARB_gpu_shader_fp64 : require
#define REAL double
#define RVEC3 dvec3
#endif
#extension GL_GOOGLE_include_directive : require
// eval.comp — Vulkan port of shim.cu evalKernel (HARD path). One workgroup per
// candidate; 128 threads stride the bbox pixels, accumulate 19 float32 sums in
// shared memory, fixed-order tree-reduce (deterministic, no atomics), then thread 0
// computes the optimal colour + ΔSSE in REAL — mirroring the CPU golden reference.
// Accumulator layout (NACC=19): 0=W 1=n 2=nt 3..6=sT(rgba) 7..10=sC 11..14=sC2 15..18=sTC.

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly  buffer Cands  { float cands[]; };
layout(std430, binding = 1) readonly  buffer Target { float target[]; };
layout(std430, binding = 2) readonly  buffer Canvas { float canvasb[]; };
layout(std430, binding = 3) readonly  buffer Weight { float weightb[]; };
layout(std430, binding = 4) writeonly buffer Out    { float outb[]; };
layout(std430, binding = 5) readonly  buffer MA     { float maskAtlas[]; };
layout(std430, binding = 6) readonly  buffer MM     { int   maskMeta[]; };
#include "mask_common.glsl"

// agN/ag0..ag5 = analytic-alpha grid (fp_set_alpha_grid): the epilogue re-solves the optimal
// colour per grid alpha and keeps the ΔSSE-min (alpha, colour) pair. agN=0 = off (pass-through).
layout(push_constant) uniform PC {
    int n; int W; int H; int sampleBudget;
    int agN; float ag0; float ag1; float ag2; float ag3; float ag4; float ag5;
    int gradOn; // 1 = score the radial gradients with their per-pixel alpha (fp_set_gradients).
                // Scoring them HONESTLY is locally correct and end-to-end WORSE: the search stops
                // over-crediting a gradient's coverage, places fewer of them, and the greedy lands
                // in a different basin that the polish cannot recover. Measured on img_9 @1000:
                // 16 gradients / 89876 SSE gated off vs 7 / 90916 forced on, and the eye sees
                // smearing over the eyes. Default OFF; FH6_GRAD_EVAL=1 turns it on for A/Bs.
} pc;

const int   NACC     = 19;
const float DEG2RAD  = 0.017453292519943295;
const float REJECTED = 3.4028235e38; // FLT_MAX, matches shim.cu REJECTED

// Half the workgroup's worth of accumulator slots, not all of it: the first reduction level pairs
// lane i with lane i+64, so lanes 64..127 park their registers and lanes 0..63 fold them in before
// the shared-memory tree starts. Same pairing, same order, same floats — but 4.9KB of shared
// memory per workgroup instead of 9.7KB, which is the occupancy limiter on small GPUs
// (GTX 1050-class: 62% -> 100% resident threads).
shared float sh[64 * NACC];
// Per-lane analytic-alpha trials (hard epilogue): up to 6 grid alphas + the candidate's own.
shared REAL trD[8], trR[8], trG[8], trB[8];
shared float trA[8];

int clampi(int v, int lo, int hi) { return v < lo ? lo : (v > hi ? hi : v); }
REAL clamp01d(REAL v) { return v < REAL(0.0) ? REAL(0.0) : (v > REAL(1.0) ? REAL(1.0) : v); }

// Per-pixel inside test in float32, mirroring shim.cu insideC. kind: 0=ellipse 1=rect 2=tri 3=line.
bool insideShape(int kind, float P[6], int x, int y) {
    float px = float(x) + 0.5;
    float py = float(y) + 0.5;
    if (kind == 2) {
        float d1 = (px - P[4]) * (P[1] - P[5]) - (P[0] - P[4]) * (py - P[5]);
        float d2 = (px - P[0]) * (P[3] - P[1]) - (P[2] - P[0]) * (py - P[1]);
        float d3 = (px - P[2]) * (P[5] - P[3]) - (P[4] - P[2]) * (py - P[3]);
        bool hasNeg = d1 < 0.0 || d2 < 0.0 || d3 < 0.0;
        bool hasPos = d1 > 0.0 || d2 > 0.0 || d3 > 0.0;
        return !(hasNeg && hasPos);
    } else if (kind == 3) {
        float x1 = P[0], y1 = P[1], x2 = P[2], y2 = P[3], hwid = max(0.5, P[4]);
        float dx = x2 - x1, dy = y2 - y1, l2 = dx * dx + dy * dy, t = 0.0;
        if (l2 > 0.0) { t = ((px - x1) * dx + (py - y1) * dy) / l2; t = clamp(t, 0.0, 1.0); }
        float projX = x1 + t * dx, projY = y1 + t * dy;
        float ddx = px - projX, ddy = py - projY;
        return ddx * ddx + ddy * ddy <= hwid * hwid;
    } else if (kind == 1) {
        float cx = P[0], cy = P[1], hw = max(0.5, P[2]), hh = max(0.5, P[3]);
        float th = P[4] * DEG2RAD, c = cos(th), s = sin(th);
        float dx = px - cx, dy = py - cy;
        float xr = dx * c + dy * s, yr = -dx * s + dy * c;
        xr -= P[5] * yr; // inverse shear — mirrors raster.RectInside
        return abs(xr) <= hw && abs(yr) <= hh;
    } else {
        float cx = P[0], cy = P[1], rx = max(1.0, P[2]), ry = max(1.0, P[3]);
        float th = P[4] * DEG2RAD, c = cos(th), s = sin(th);
        float dx = px - cx, dy = py - cy;
        float xr = dx * c + dy * s, yr = -dx * s + dy * c;
        xr -= P[5] * yr; // mirrors raster.EllipseInside
        return xr * xr / (rx * rx) + yr * yr / (ry * ry) <= 1.0;
    }
}

// ---- radial-gradient coverage (mirrors raster.FalloffGlow / FalloffDisk and shim.cu gradFalloff) ----
// The native FH6 gradient kinds (KindGlow=4, KindDisk=5) contribute a per-pixel alpha
// A*falloff(t), t = elliptical normalised radius. Constants are calibrated in-game; they must
// match internal/raster/gradient.go and the CUDA shim exactly.
#define GRAD_GLOW_E 0.0820849986238988
float gradFalloff(int kind, float t2) {
    if (t2 >= 1.0) return 0.0;
    if (kind == 4) { // soft gaussian glow: 0.89 * (exp(-2.5 t2) - e) / (1 - e)
        float g = (exp(-2.5 * t2) - float(GRAD_GLOW_E)) / (1.0 - float(GRAD_GLOW_E));
        return 0.89 * g;
    }
    float t = sqrt(t2); // disk: opaque core to 0.40, then 1 - smoothstep over the rim
    if (t <= 0.40) return 1.0;
    float u = (t - 0.40) * (1.0 / 0.60);
    return 1.0 - (3.0 * u * u - 2.0 * u * u * u);
}

float gradCovP(int kind, float P[6], int x, int y) {
    float rx = max(1.0, P[2]), ry = max(1.0, P[3]);
    float th = P[4] * 0.017453292519943295;
    float c = cos(th), sn = sin(th);
    float dx = (float(x) + 0.5) - P[0], dy = (float(y) + 0.5) - P[1];
    float xr = dx * c + dy * sn, yr = -dx * sn + dy * c;
    xr -= P[5] * yr; // mirrors raster.ellipseNormRadius
    return gradFalloff(kind, xr * xr / (rx * rx) + yr * yr / (ry * ry));
}

bool isGradKind(int kind) { return kind == 4 || kind == 5 || kind >= MASKBASE; }

// gradCov dispatches the per-pixel alpha: radial falloff for glow/disk, atlas sample for a word.
float gradCov(int kind, float P[6], int x, int y) {
    if (kind >= MASKBASE) return maskCovP(kind, P, x, y);
    return gradCovP(kind, P, x, y);
}

void bboxOf(int kind, float P[6], int W, int H, out int xMin, out int yMin, out int xMax, out int yMax) {
    if (kind >= MASKBASE) { maskBBoxOf(P, W, H, xMin, yMin, xMax, yMax); return; }
    if (kind == 2) {
        float minX = min(P[0], min(P[2], P[4])), maxX = max(P[0], max(P[2], P[4]));
        float minY = min(P[1], min(P[3], P[5])), maxY = max(P[1], max(P[3], P[5]));
        xMin = clampi(int(floor(minX)), 0, W - 1); xMax = clampi(int(ceil(maxX)), 0, W - 1);
        yMin = clampi(int(floor(minY)), 0, H - 1); yMax = clampi(int(ceil(maxY)), 0, H - 1);
    } else if (kind == 3) {
        float x1 = P[0], y1 = P[1], x2 = P[2], y2 = P[3], hwid = max(0.5, P[4]);
        xMin = clampi(int(floor(min(x1, x2) - hwid)), 0, W - 1); xMax = clampi(int(ceil(max(x1, x2) + hwid)), 0, W - 1);
        yMin = clampi(int(floor(min(y1, y2) - hwid)), 0, H - 1); yMax = clampi(int(ceil(max(y1, y2) + hwid)), 0, H - 1);
    } else if (kind == 1) {
        float cx = P[0], cy = P[1], hw = max(0.5, P[2]), hh = max(0.5, P[3]);
        float th = P[4] * DEG2RAD, c = cos(th), s = sin(th);
        float shx = hw + abs(P[5]) * hh; // shear widens the x half-extent — mirrors raster.RectBBox
        float ex = abs(shx * c) + abs(hh * s), ey = abs(shx * s) + abs(hh * c);
        xMin = clampi(int(floor(cx - ex - 1.0)), 0, W - 1); xMax = clampi(int(ceil(cx + ex + 1.0)), 0, W - 1);
        yMin = clampi(int(floor(cy - ey - 1.0)), 0, H - 1); yMax = clampi(int(ceil(cy + ey + 1.0)), 0, H - 1);
    } else {
        float cx = P[0], cy = P[1], rx = max(1.0, P[2]), ry = max(1.0, P[3]);
        float th = P[4] * DEG2RAD, c = cos(th), s = sin(th);
        float ex, ey;
        if (P[5] != 0.0) { // mirrors raster.EllipseBBox: conservative box around the sheared ellipse
            float shx = sqrt(rx * rx + P[5] * P[5] * ry * ry);
            ex = abs(shx * c) + abs(ry * s); ey = abs(shx * s) + abs(ry * c);
        } else {
            ex = sqrt(rx * rx * c * c + ry * ry * s * s); ey = sqrt(rx * rx * s * s + ry * ry * c * c);
        }
        xMin = clampi(int(floor(cx - ex - 1.0)), 0, W - 1); xMax = clampi(int(ceil(cx + ex + 1.0)), 0, W - 1);
        yMin = clampi(int(floor(cy - ey - 1.0)), 0, H - 1); yMax = clampi(int(ceil(cy + ey + 1.0)), 0, H - 1);
    }
}

void main() {
    uint gid = gl_WorkGroupID.x;
    uint lid = gl_LocalInvocationID.x;

    int kind = 999;
    float Ain = 0.0;
    int step = 1;
    float L[NACC];
    for (int k = 0; k < NACC; k++) L[k] = 0.0;

    if (gid < uint(pc.n)) {
        uint base = gid * 11u;
        kind = int(cands[base] + 0.5);
        float P[6];
        P[0] = cands[base + 1u]; P[1] = cands[base + 2u]; P[2] = cands[base + 3u];
        P[3] = cands[base + 4u]; P[4] = cands[base + 5u]; P[5] = cands[base + 6u];
        Ain = cands[base + 10u];

        if (kind <= 5 || kind >= MASKBASE) {
            int xMin, yMin, xMax, yMax;
            bboxOf(kind, P, pc.W, pc.H, xMin, yMin, xMax, yMax);
            int area = (xMax - xMin + 1) * (yMax - yMin + 1);
            int budget = pc.sampleBudget < 1 ? 4000 : pc.sampleBudget;
            if (area > budget) { step = int(sqrt(float(area) / float(budget))); if (step < 1) step = 1; }
            int cols = (xMax - xMin) / step + 1;
            int rows = (yMax - yMin) / step + 1;
            int total = cols * rows;
            // Mask words take the per-pixel-alpha branch UNCONDITIONALLY. Their coverage is per-pixel
            // by construction, so scoring them any other way is not a preference but an error, and
            // gating them on pc.gradOn made one flag own two unrelated decisions: that flag is
            // deliberately off (honest gradient scoring measured worse end-to-end), which silently
            // left the whole dictionary path unscored. Evaluate returned FLT_MAX for every word, so
            // the glyph pre-pass claimed nothing on Vulkan while CUDA claimed ~60 on the same image.
            // Glow and disk keep obeying pc.gradOn — that decision was about them.
            if (kind >= MASKBASE || (isGradKind(kind) && pc.gradOn != 0)) {
                // Per-pixel alpha a(x)=A*cov. The accumulator slots differ from the hard path:
                // L0=sum(w a^2) L1=n L2=n_transparent | L3-5=sum(w a r) | L6-8=sum(w a^2 s) |
                // L9-11=sum(w a r s) | L12-14=sum(w a^2 s^2) | L15=alpha dSSE | L16=spill.
                float ac = clamp(Ain, 1e-3, 1.0);
                // Strength-reduced (x,y): the per-sample % and / on a runtime divisor compile to
                // ~20-instruction emulation sequences (no hardware integer divide) and were two
                // thirds of the loop's address ALU. The recurrence visits the IDENTICAL (x,y)
                // sequence per thread, so sums are bit-identical. dr < cols always, so one
                // conditional subtract renormalises.
                int cxi = int(lid) % cols, cyi = int(lid) / cols;
                int dq = 128 / cols, dr = 128 % cols;
                for (int tt = int(lid); tt < total; tt += 128) {
                    int x = xMin + cxi * step;
                    int y = yMin + cyi * step;
                    cxi += dr; cyi += dq;
                    if (cxi >= cols) { cxi -= cols; cyi++; }
                    float cov = gradCov(kind, P, x, y);
                    if (cov <= 0.0) continue;
                    float ap = ac * cov;
                    int idx = y * pc.W + x, p = idx * 4;
                    float ta = target[p + 3];
                    float wgt = weightb[idx];
                    float wa = wgt * ap, wa2 = wa * ap;
                    if (ta < 0.5) { L[2] += 1.0; L[16] += wa2; continue; }
                    float sr = canvasb[p], sg = canvasb[p + 1], sb = canvasb[p + 2], sa = canvasb[p + 3];
                    float rr = target[p] - sr, rg = target[p + 1] - sg, rb = target[p + 2] - sb;
                    L[0] += wa2; L[1] += 1.0;
                    L[3] += wa * rr; L[4] += wa * rg; L[5] += wa * rb;
                    L[6] += wa2 * sr; L[7] += wa2 * sg; L[8] += wa2 * sb;
                    L[9] += wa * rr * sr; L[10] += wa * rg * sg; L[11] += wa * rb * sb;
                    L[12] += wa2 * sr * sr; L[13] += wa2 * sg * sg; L[14] += wa2 * sb * sb;
                    float oms = 1.0 - sa;
                    L[15] += wgt * (ap * ap * oms * oms - 2.0 * ap * oms * (ta - sa));
                }
            } else {
            // Same strength reduction as the gradient branch above; same bit-identity argument.
            int cxi = int(lid) % cols, cyi = int(lid) / cols;
            int dq = 128 / cols, dr = 128 % cols;
            for (int tt = int(lid); tt < total; tt += 128) {
                int x = xMin + cxi * step;
                int y = yMin + cyi * step;
                cxi += dr; cyi += dq;
                if (cxi >= cols) { cxi -= cols; cyi++; }
                if (!insideShape(kind, P, x, y)) continue;
                int idx = y * pc.W + x, p = idx * 4;
                float ta = target[p + 3];
                if (ta < 0.5) { L[2] += 1.0; continue; }
                float wgt = weightb[idx];
                float tr = target[p], tg = target[p + 1], tb = target[p + 2];
                float sr = canvasb[p], sg = canvasb[p + 1], sb = canvasb[p + 2], sa = canvasb[p + 3];
                L[0] += wgt; L[1] += 1.0;
                L[3] += wgt * tr; L[4] += wgt * tg; L[5] += wgt * tb; L[6] += wgt * ta;
                L[7] += wgt * sr; L[8] += wgt * sg; L[9] += wgt * sb; L[10] += wgt * sa;
                L[11] += wgt * sr * sr; L[12] += wgt * sg * sg; L[13] += wgt * sb * sb; L[14] += wgt * sa * sa;
                L[15] += wgt * tr * sr; L[16] += wgt * tg * sg; L[17] += wgt * tb * sb; L[18] += wgt * ta * sa;
            }
            }
        }
    }

    if (lid >= 64u) {
        for (int k = 0; k < NACC; k++) sh[(lid - 64u) * uint(NACC) + uint(k)] = L[k];
    }
    barrier();
    if (lid < 64u) {
        for (int k = 0; k < NACC; k++) { L[k] += sh[lid * uint(NACC) + uint(k)]; sh[lid * uint(NACC) + uint(k)] = L[k]; }
    }
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1) {
        if (lid < s)
            for (int k = 0; k < NACC; k++) sh[lid * uint(NACC) + uint(k)] += sh[(lid + s) * uint(NACC) + uint(k)];
        barrier();
    }
    if (gid >= uint(pc.n)) return;

    // The whole workgroup stays alive past this point: with the analytic-alpha grid on, the
    // alpha trials below run one-per-lane instead of as a serial fp64 chain on lane 0 (the chain
    // ran at the 1/32 fp64 rate on consumer parts while 127 lanes waited). Every branch taken
    // before the trial barrier is uniform across the workgroup.
    uint ob = gid * 5u;
    REAL a = REAL(Ain);
    if (a < REAL(1e-3)) a = REAL(1e-3);
    if (a > REAL(1.0)) a = REAL(1.0);
    REAL W_ = REAL(sh[0]), nn = REAL(sh[1]), nt = REAL(sh[2]);
    // Same split as the accumulation branch: a mask word is per-pixel by construction and must be
    // reduced the way it was accumulated. Reducing it down the hard path reads accumulator slots that
    // the gradient branch filled with different quantities, which is how every word came back
    // REJECTED with an FLT_MAX score.
    if (kind >= MASKBASE || (isGradKind(kind) && pc.gradOn != 0)) {
        if (lid != 0u) return;
        // Gradient epilogue: the per-pixel alpha makes the optimal colour a weighted ratio and the
        // dSSE a quadratic in it. Mirrors the CUDA gradient branch term for term.
        REAL saa = W_;
        if (nn < REAL(1.0) || saa <= REAL(0.0)) { outb[ob] = REJECTED; return; }
        if (nt > REAL(0.0) && nt > REAL(1.5) * nn) { outb[ob] = REJECTED; return; }
        REAL sarR = REAL(sh[3]), sarG = REAL(sh[4]), sarB = REAL(sh[5]);
        REAL saasR = REAL(sh[6]), saasG = REAL(sh[7]), saasB = REAL(sh[8]);
        REAL sarsR = REAL(sh[9]), sarsG = REAL(sh[10]), sarsB = REAL(sh[11]);
        REAL saassR = REAL(sh[12]), saassG = REAL(sh[13]), saassB = REAL(sh[14]);
        REAL dAcc = REAL(sh[15]), saaT = REAL(sh[16]);
        REAL oR = clamp((sarR + saasR) / saa, REAL(0.0), REAL(1.0));
        REAL oG = clamp((sarG + saasG) / saa, REAL(0.0), REAL(1.0));
        REAL oB = clamp((sarB + saasB) / saa, REAL(0.0), REAL(1.0));
        REAL td = dAcc;
        td += REAL(2.0) * sarsR + saassR - REAL(2.0) * oR * (sarR + saasR) + oR * oR * saa;
        td += REAL(2.0) * sarsG + saassG - REAL(2.0) * oG * (sarG + saasG) + oG * oG * saa;
        td += REAL(2.0) * sarsB + saassB - REAL(2.0) * oB * (sarB + saasB) + oB * oB * saa;
        if (nt > REAL(0.0)) {
            REAL spillFrac = nt / (nn + nt);
            td += saaT * (REAL(1.0) + REAL(2.0) * spillFrac) * (oR * oR + oG * oG + oB * oB + REAL(1.0));
        }
        outb[ob] = float(td * REAL(step * step));
        outb[ob + 1u] = float(oR); outb[ob + 2u] = float(oG); outb[ob + 3u] = float(oB);
        outb[ob + 4u] = Ain;
        return;
    }
    if (kind > 5 || nn < REAL(1.0) || W_ <= REAL(0.0)) { if (lid == 0u) outb[ob] = REJECTED; return; }
    if (nt > REAL(0.0) && nt > REAL(1.5) * nn) { if (lid == 0u) outb[ob] = REJECTED; return; }
    REAL sTR = REAL(sh[3]), sTG = REAL(sh[4]), sTB = REAL(sh[5]), sTA = REAL(sh[6]);
    REAL sCR = REAL(sh[7]), sCG = REAL(sh[8]), sCB = REAL(sh[9]), sCA = REAL(sh[10]);
    REAL sCR2 = REAL(sh[11]), sCG2 = REAL(sh[12]), sCB2 = REAL(sh[13]), sCA2 = REAL(sh[14]);
    REAL sTCR = REAL(sh[15]), sTCG = REAL(sh[16]), sTCB = REAL(sh[17]), sTCA = REAL(sh[18]);
    REAL invW = REAL(1.0) / W_;
    // Mirrors shim.cu hardEpilogue: k=-1 scores the candidate's own alpha (grid off keeps exactly
    // that, alpha passed through raw); grid alphas then compete and the ΔSSE-min pair wins.
    // The trials are independent given the sums, so each runs on its own LANE (expressions kept
    // verbatim); lane 0 then selects walking k = -1, 0, 1, ... with the same strict-< first-wins
    // rule the serial loop applied — same values, same selection, agN+1x shorter fp64 chain.
    float agv[6] = float[6](pc.ag0, pc.ag1, pc.ag2, pc.ag3, pc.ag4, pc.ag5);
    int trials = pc.agN + 1;
    if (lid < uint(trials)) {
        int k = int(lid) - 1;
        REAL aa = a;
        if (k >= 0) {
            aa = REAL(agv[k]);
            if (aa < REAL(1e-3)) aa = REAL(1e-3);
            if (aa > REAL(1.0)) aa = REAL(1.0);
        }
        REAL invA = REAL(1.0) - aa;
        REAL oR = clamp01d((sTR * invW - (sCR * invW) * invA) / aa);
        REAL oG = clamp01d((sTG * invW - (sCG * invW) * invA) / aa);
        REAL oB = clamp01d((sTB * invW - (sCB * invW) * invA) / aa);
        REAL a2 = aa * aa, twoA = REAL(2.0) * aa;
        REAL dR = a2 * (W_ * oR * oR - REAL(2.0) * oR * sCR + sCR2) - twoA * (oR * sTR - oR * sCR - sTCR + sCR2);
        REAL dG = a2 * (W_ * oG * oG - REAL(2.0) * oG * sCG + sCG2) - twoA * (oG * sTG - oG * sCG - sTCG + sCG2);
        REAL dB = a2 * (W_ * oB * oB - REAL(2.0) * oB * sCB + sCB2) - twoA * (oB * sTB - oB * sCB - sTCB + sCB2);
        REAL dA = a2 * (W_ - REAL(2.0) * sCA + sCA2) - twoA * (sTA - sCA - sTCA + sCA2);
        REAL totalDelta = dR + dG + dB + dA;
        if (nt > REAL(0.0)) {
            REAL spillFrac = nt / (nn + nt);
            totalDelta += a2 * nt * (REAL(1.0) + REAL(2.0) * spillFrac) * (oR * oR + oG * oG + oB * oB + REAL(1.0));
        }
        trD[lid] = totalDelta;
        trR[lid] = oR; trG[lid] = oG; trB[lid] = oB;
        trA[lid] = (k < 0) ? Ain : float(aa);
    }
    barrier();
    if (lid != 0u) return;
    REAL bR = trR[0], bG = trG[0], bB = trB[0], bD = trD[0];
    float bA = trA[0];
    for (int j = 1; j < trials; j++) {
        if (trD[j] < bD) {
            bR = trR[j]; bG = trG[j]; bB = trB[j]; bD = trD[j];
            bA = trA[j];
        }
    }
    outb[ob + 0u] = float(bD * REAL(step * step));
    outb[ob + 1u] = float(bR);
    outb[ob + 2u] = float(bG);
    outb[ob + 3u] = float(bB);
    outb[ob + 4u] = bA;
}
