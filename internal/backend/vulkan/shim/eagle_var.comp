#version 450
#ifdef FH6_FP32
#define REAL float
#define RVEC3 vec3
#else
#extension GL_ARB_gpu_shader_fp64 : require
#define REAL double
#define RVEC3 dvec3
#endif
// eagle_var.comp — zero-padded fixed-1/9 3x3 patch variance + mean of BOTH Scharr planes
// (engine eagleState.patchVar; same dy->dx accumulation order).
layout(local_size_x = 256) in;
layout(std430, binding = 3) readonly buffer GX { REAL gx[]; };
layout(std430, binding = 4) readonly buffer GY { REAL gy[]; };
layout(std430, binding = 5)          buffer VX { REAL vx[]; };
layout(std430, binding = 6)          buffer VY { REAL vy[]; };
layout(std430, binding = 7)          buffer MX { REAL mx[]; };
layout(std430, binding = 8)          buffer MY { REAL my[]; };
layout(push_constant) uniform PC { int w, h, dir, mode; float lambda; } pc;
void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= pc.w * pc.h) return;
    int x = i % pc.w, y = i / pc.w;
    REAL sx1 = REAL(0.0), sx2 = REAL(0.0), sy1 = REAL(0.0), sy2 = REAL(0.0);
    for (int dy = -1; dy <= 1; dy++) {
        int yy = y + dy;
        if (yy < 0 || yy >= pc.h) continue;
        for (int dx = -1; dx <= 1; dx++) {
            int xx = x + dx;
            if (xx < 0 || xx >= pc.w) continue;
            REAL a = gx[yy * pc.w + xx];
            REAL b = gy[yy * pc.w + xx];
            sx1 += a; sx2 += a * a; sy1 += b; sy2 += b * b;
        }
    }
    REAL mmx = sx1 / REAL(9.0), mmy = sy1 / REAL(9.0);
    mx[i] = mmx; vx[i] = sx2 / REAL(9.0) - mmx * mmx;
    my[i] = mmy; vy[i] = sy2 / REAL(9.0) - mmy * mmy;
}
