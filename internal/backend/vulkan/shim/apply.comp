#version 450
#extension GL_GOOGLE_include_directive : require
// apply.comp — Vulkan port of shim.cu applyKernel / cpu.Apply. Composites one shape
// onto the device canvas at full coverage (step 1, exact). Dispatched with enough
// workgroups that #threads >= image area, so each covered pixel is written exactly
// once (race-free, no atomics). Geometry mirrors eval.comp's float32 inside test.

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Canvas { float canvasb[]; };
layout(std430, binding = 1) readonly buffer MA { float maskAtlas[]; };
layout(std430, binding = 2) readonly buffer MM { int   maskMeta[]; };
#include "mask_common.glsl"

layout(push_constant) uniform PC {
    int kind;
    float p0, p1, p2, p3, p4, p5;
    float cr, cg, cb, ca;
    int W, H;
} pc;

const float DEG2RAD = 0.017453292519943295;

int clampi(int v, int lo, int hi) { return v < lo ? lo : (v > hi ? hi : v); }

bool insideShape(int kind, float P[6], int x, int y) {
    float px = float(x) + 0.5;
    float py = float(y) + 0.5;
    if (kind == 2) {
        float d1 = (px - P[4]) * (P[1] - P[5]) - (P[0] - P[4]) * (py - P[5]);
        float d2 = (px - P[0]) * (P[3] - P[1]) - (P[2] - P[0]) * (py - P[1]);
        float d3 = (px - P[2]) * (P[5] - P[3]) - (P[4] - P[2]) * (py - P[3]);
        bool hasNeg = d1 < 0.0 || d2 < 0.0 || d3 < 0.0;
        bool hasPos = d1 > 0.0 || d2 > 0.0 || d3 > 0.0;
        return !(hasNeg && hasPos);
    } else if (kind == 3) {
        float x1 = P[0], y1 = P[1], x2 = P[2], y2 = P[3], hwid = max(0.5, P[4]);
        float dx = x2 - x1, dy = y2 - y1, l2 = dx * dx + dy * dy, t = 0.0;
        if (l2 > 0.0) { t = ((px - x1) * dx + (py - y1) * dy) / l2; t = clamp(t, 0.0, 1.0); }
        float projX = x1 + t * dx, projY = y1 + t * dy;
        float ddx = px - projX, ddy = py - projY;
        return ddx * ddx + ddy * ddy <= hwid * hwid;
    } else if (kind == 1) {
        float cx = P[0], cy = P[1], hw = max(0.5, P[2]), hh = max(0.5, P[3]);
        float th = P[4] * DEG2RAD, c = cos(th), s = sin(th);
        float dx = px - cx, dy = py - cy;
        float xr = dx * c + dy * s, yr = -dx * s + dy * c;
        xr -= P[5] * yr; // inverse shear — mirrors raster.RectInside
        return abs(xr) <= hw && abs(yr) <= hh;
    } else {
        float cx = P[0], cy = P[1], rx = max(1.0, P[2]), ry = max(1.0, P[3]);
        float th = P[4] * DEG2RAD, c = cos(th), s = sin(th);
        float dx = px - cx, dy = py - cy;
        float xr = dx * c + dy * s, yr = -dx * s + dy * c;
        xr -= P[5] * yr; // mirrors raster.EllipseInside
        return xr * xr / (rx * rx) + yr * yr / (ry * ry) <= 1.0;
    }
}

// Radial-gradient coverage — same constants as eval.comp, raster/gradient.go and the CUDA shim.
#define GRAD_GLOW_E 0.0820849986238988
float gradFalloff(int kind, float t2) {
    if (t2 >= 1.0) return 0.0;
    if (kind == 4) {
        float g = (exp(-2.5 * t2) - float(GRAD_GLOW_E)) / (1.0 - float(GRAD_GLOW_E));
        return 0.89 * g;
    }
    float t = sqrt(t2);
    if (t <= 0.40) return 1.0;
    float u = (t - 0.40) * (1.0 / 0.60);
    return 1.0 - (3.0 * u * u - 2.0 * u * u * u);
}

float gradCovP(int kind, float P[6], int x, int y) {
    float rx = max(1.0, P[2]), ry = max(1.0, P[3]);
    float th = P[4] * 0.017453292519943295;
    float c = cos(th), sn = sin(th);
    float dx = (float(x) + 0.5) - P[0], dy = (float(y) + 0.5) - P[1];
    float xr = dx * c + dy * sn, yr = -dx * sn + dy * c;
    xr -= P[5] * yr; // mirrors raster.ellipseNormRadius
    return gradFalloff(kind, xr * xr / (rx * rx) + yr * yr / (ry * ry));
}

bool isGradKind(int kind) { return kind == 4 || kind == 5 || kind >= MASKBASE; }

float gradCov(int kind, float P[6], int x, int y) {
    if (kind >= MASKBASE) return maskCovP(kind, P, x, y);
    return gradCovP(kind, P, x, y);
}

void bboxOf(int kind, float P[6], int W, int H, out int xMin, out int yMin, out int xMax, out int yMax) {
    if (kind >= MASKBASE) { maskBBoxOf(P, W, H, xMin, yMin, xMax, yMax); return; }
    if (kind == 2) {
        float minX = min(P[0], min(P[2], P[4])), maxX = max(P[0], max(P[2], P[4]));
        float minY = min(P[1], min(P[3], P[5])), maxY = max(P[1], max(P[3], P[5]));
        xMin = clampi(int(floor(minX)), 0, W - 1); xMax = clampi(int(ceil(maxX)), 0, W - 1);
        yMin = clampi(int(floor(minY)), 0, H - 1); yMax = clampi(int(ceil(maxY)), 0, H - 1);
    } else if (kind == 3) {
        float x1 = P[0], y1 = P[1], x2 = P[2], y2 = P[3], hwid = max(0.5, P[4]);
        xMin = clampi(int(floor(min(x1, x2) - hwid)), 0, W - 1); xMax = clampi(int(ceil(max(x1, x2) + hwid)), 0, W - 1);
        yMin = clampi(int(floor(min(y1, y2) - hwid)), 0, H - 1); yMax = clampi(int(ceil(max(y1, y2) + hwid)), 0, H - 1);
    } else if (kind == 1) {
        float cx = P[0], cy = P[1], hw = max(0.5, P[2]), hh = max(0.5, P[3]);
        float th = P[4] * DEG2RAD, c = cos(th), s = sin(th);
        float shx = hw + abs(P[5]) * hh; // shear widens the x half-extent — mirrors raster.RectBBox
        float ex = abs(shx * c) + abs(hh * s), ey = abs(shx * s) + abs(hh * c);
        xMin = clampi(int(floor(cx - ex - 1.0)), 0, W - 1); xMax = clampi(int(ceil(cx + ex + 1.0)), 0, W - 1);
        yMin = clampi(int(floor(cy - ey - 1.0)), 0, H - 1); yMax = clampi(int(ceil(cy + ey + 1.0)), 0, H - 1);
    } else {
        float cx = P[0], cy = P[1], rx = max(1.0, P[2]), ry = max(1.0, P[3]);
        float th = P[4] * DEG2RAD, c = cos(th), s = sin(th);
        float ex, ey;
        if (P[5] != 0.0) { // mirrors raster.EllipseBBox: conservative box around the sheared ellipse
            float shx = sqrt(rx * rx + P[5] * P[5] * ry * ry);
            ex = abs(shx * c) + abs(ry * s); ey = abs(shx * s) + abs(ry * c);
        } else {
            ex = sqrt(rx * rx * c * c + ry * ry * s * s); ey = sqrt(rx * rx * s * s + ry * ry * c * c);
        }
        xMin = clampi(int(floor(cx - ex - 1.0)), 0, W - 1); xMax = clampi(int(ceil(cx + ex + 1.0)), 0, W - 1);
        yMin = clampi(int(floor(cy - ey - 1.0)), 0, H - 1); yMax = clampi(int(ceil(cy + ey + 1.0)), 0, H - 1);
    }
}

void main() {
    if (pc.kind > 5 && pc.kind < MASKBASE) return;
    float P[6] = float[6](pc.p0, pc.p1, pc.p2, pc.p3, pc.p4, pc.p5);
    int xMin, yMin, xMax, yMax;
    bboxOf(pc.kind, P, pc.W, pc.H, xMin, yMin, xMax, yMax);
    int cols = xMax - xMin + 1, rows = yMax - yMin + 1, total = cols * rows;
    if (total <= 0) return;
    float aBase = clamp(pc.ca, 0.0, 1.0);
    bool grad = isGradKind(pc.kind);
    int threads = int(gl_NumWorkGroups.x * gl_WorkGroupSize.x);
    for (int tt = int(gl_GlobalInvocationID.x); tt < total; tt += threads) {
        int x = xMin + tt % cols, y = yMin + tt / cols;
        float a = aBase;
        if (grad) { // per-pixel falloff: aEff = A * cov(x)
            float cov = gradCov(pc.kind, P, x, y);
            if (cov <= 0.0) continue;
            a *= cov;
        } else if (!insideShape(pc.kind, P, x, y)) {
            continue;
        }
        float invA = 1.0 - a;
        int p = (y * pc.W + x) * 4;
        canvasb[p + 0] = canvasb[p + 0] * invA + pc.cr * a;
        canvasb[p + 1] = canvasb[p + 1] * invA + pc.cg * a;
        canvasb[p + 2] = canvasb[p + 2] * invA + pc.cb * a;
        canvasb[p + 3] = canvasb[p + 3] * invA + a;
    }
}
