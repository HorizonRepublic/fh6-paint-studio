#version 450
#ifdef FH6_FP32
#define REAL float
#define RVEC3 vec3
#else
#extension GL_ARB_gpu_shader_fp64 : require
#define REAL double
#define RVEC3 dvec3
#endif
// eagle_loss.comp — sum |hx-tHx|+|hy-tHy| into workgroup partials (NO atomics; the host adds
// lambda*sum in fixed order — engine eagleState.forward loss).
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer THX { REAL tHx[]; };
layout(std430, binding = 9) readonly buffer HX { REAL hx[]; };
layout(std430, binding = 10) readonly buffer HY { REAL hy[]; };
layout(std430, binding = 11) readonly buffer THY { REAL tHy[]; };
layout(std430, binding = 17)          buffer Pb { REAL parts[]; };
layout(std430, binding = 18) readonly buffer TW { float tw[]; };
layout(push_constant) uniform PC { int w, h, dir, mode; float lambda; int hasTW; } pc;
shared REAL sh[256];
void main() {
    int N = pc.w * pc.h;
    REAL s = REAL(0.0);
    for (int i = int(gl_GlobalInvocationID.x); i < N; i += int(gl_NumWorkGroups.x) * 256) {
        REAL wi = pc.hasTW != 0 ? REAL(tw[i]) : REAL(1.0);
        s += wi * (abs(hx[i] - tHx[i]) + abs(hy[i] - tHy[i]));
    }
    sh[gl_LocalInvocationID.x] = s;
    barrier();
    for (uint st = 128; st > 0; st >>= 1) {
        if (gl_LocalInvocationID.x < st) sh[gl_LocalInvocationID.x] += sh[gl_LocalInvocationID.x + st];
        barrier();
    }
    if (gl_LocalInvocationID.x == 0) parts[gl_WorkGroupID.x] = sh[0];
}
