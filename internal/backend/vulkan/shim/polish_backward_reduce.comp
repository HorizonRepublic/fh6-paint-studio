#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_GOOGLE_include_directive : require
// polish_backward_reduce.comp — TILED backward Pass B: one workgroup per shape (dispatched
// as N workgroups in ONE call, so there are NO inter-shape barriers — each shape reads only
// its own dcsnap region and writes only its own pgrad slot). 128 threads stride the shape's
// bbox, re-deriving the geometry gradient and accumulating the 10 parameter gradients in
// double, summed by a fixed-order tree reduction matching engine.polishBackward (so the
// result is bit-identical). dC was already propagated + snapshotted by Pass A
// (polish_dcwalk_tiled), so this pass only reads dcsnap; it never writes dC.

layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly  buffer Pb { double Pbuf[]; };
layout(std430, binding = 1) readonly  buffer Cb { double Cbuf[]; };
layout(std430, binding = 2) readonly  buffer Kb { int    Kbuf[]; };
layout(std430, binding = 4) readonly  buffer Bb { float  belowb[]; };
layout(std430, binding = 5) readonly  buffer Sb { float  dcsnap[]; };
layout(std430, binding = 6) writeonly buffer Gb { double pgrad[]; };
layout(std430, binding = 7) readonly  buffer Xb { int    bbx[]; };
layout(std430, binding = 8) readonly  buffer Ob { int    boff[]; };
layout(push_constant) uniform PC { int n, w, h, ste; float tau; } pc;
#include "polish_common.glsl"

const int NG = 10;
shared double sh[128 * NG];

void main() {
    uint lid = gl_LocalInvocationID.x;
    int si = int(gl_WorkGroupID.x);
    if (si >= pc.n) si = pc.n - 1; // never fires (exactly n workgroups dispatched); keeps si uniform-safe
    int kind = Kbuf[si];
    float P[6]; for (int k = 0; k < 6; k++) P[k] = float(Pbuf[si * 6 + k]);
    float R = float(Cbuf[si * 4 + 0]), G = float(Cbuf[si * 4 + 1]), B = float(Cbuf[si * 4 + 2]), A = float(Cbuf[si * 4 + 3]);
    bool opt = optGeoKind(kind);

    double acc[NG];
    for (int k = 0; k < NG; k++) acc[k] = 0.0LF;

    int xMin = bbx[si * 4], yMin = bbx[si * 4 + 1], xMax = bbx[si * 4 + 2], yMax = bbx[si * 4 + 3];
    int bw = xMax - xMin + 1, bh = yMax - yMin + 1;
    int total = (bw < 1 || bh < 1) ? 0 : bw * bh;
    int bo = boff[si];
    for (int tid = int(lid); tid < total; tid += 128) {
        int x = xMin + tid % bw, y = yMin + tid / bw;
        int bi = bo + tid * 4;

        float covEff = 0.0, dcovdsdf = 0.0;
        float sdfg[6]; for (int k = 0; k < 6; k++) sdfg[k] = 0.0;
        bool geoActive = false;
        if (isGradKind(kind)) {
            float gg[6];
            float cov = gaussianCovGrad(kind, P, x, y, gg);
            covEff = cov;
            if (kind == 4) { // the glow trains its geometry; the disk's is frozen
                for (int k = 0; k < 6; k++) sdfg[k] = gg[k];
                dcovdsdf = 1.0;
                geoActive = cov > 1e-9;
            }
        } else if (opt) {
            float g[6];
            float sdf = sdfGradKind(kind, P, float(x) + 0.5, float(y) + 0.5, g);
            float covS = sigmoidCov(sdf, pc.tau);
            dcovdsdf = -covS * (1.0 - covS) / pc.tau;
            for (int k = 0; k < 6; k++) sdfg[k] = g[k];
            if (pc.ste != 0) { covEff = (sdf <= 0.0) ? 1.0 : 0.0; geoActive = covS > 1e-12; }
            else            { covEff = covS;                      geoActive = covS > 0.0; }
        } else if (insideShape(kind, P, x, y)) {
            covEff = 1.0;
        }
        bool colorActive = covEff > 0.0;
        if (!geoActive && !colorActive) continue;

        float d0 = dcsnap[bi + 0], d1 = dcsnap[bi + 1], d2 = dcsnap[bi + 2], d3 = dcsnap[bi + 3];
        float cb0 = belowb[bi + 0], cb1 = belowb[bi + 1], cb2 = belowb[bi + 2], cb3 = belowb[bi + 3];
        float da = d0 * (R - cb0) + d1 * (G - cb1) + d2 * (B - cb2) + d3 * (1.0 - cb3);
        if (colorActive) {
            float a = A * covEff;
            acc[6] += double(d0 * a);
            acc[7] += double(d1 * a);
            acc[8] += double(d2 * a);
            acc[9] += double(da * covEff);
        }
        if (geoActive) {
            float dsdf = (da * A) * dcovdsdf;
            for (int k = 0; k < 6; k++) acc[k] += double(dsdf * sdfg[k]);
        }
    }

    for (int k = 0; k < NG; k++) sh[lid * uint(NG) + uint(k)] = acc[k];
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1) {
        if (lid < s)
            for (int k = 0; k < NG; k++) sh[lid * uint(NG) + uint(k)] += sh[(lid + s) * uint(NG) + uint(k)];
        barrier();
    }
    if (lid == 0u)
        for (int k = 0; k < NG; k++) pgrad[si * NG + k] = sh[uint(k)];
}
