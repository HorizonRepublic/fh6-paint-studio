#version 450
#ifdef FH6_FP32
#define REAL float
#define RVEC3 vec3
#else
#extension GL_ARB_gpu_shader_fp64 : require
#define REAL double
#define RVEC3 dvec3
#endif
// momentseed.comp — fit K covariance-ellipse seeds from the residual error grid (port of
// shim.cu momentSeedKernel + momentFitDevice). Each thread samples a centre from the
// error-grid CDF (same importance bias as the random search), caps its radius at the
// boundary, and fits the residual blob's covariance ellipse (in REAL; sqrt/atan via
// float). An empty window falls back to a round seed so genmoment always has a seed.

layout(local_size_x = 128) in;
layout(std430, binding = 0) writeonly buffer Sd { float seeds[]; };
layout(std430, binding = 1) readonly  buffer Gc { float gridCDF[]; };
layout(std430, binding = 2) readonly  buffer Bd { float boundDist[]; };
layout(push_constant) uniform PC {
    uint seedLo, seedHi; int K, gw, gh, W, H, hasBound, aniso; float maxR, boundPad, boundMix;
} pc;

uint wanghash(uint x) { x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16; return x; }
float uf(uint i, inout uint ctr) {
    uint a = pc.seedLo ^ 0x9e3779b9u, b = pc.seedHi;
    ctr += 1u;
    uint h = wanghash(a + wanghash(i + 0x85ebca6bu) + wanghash((b ^ ctr) * 0xc2b2ae35u));
    return float(h >> 8) * (1.0 / 16777216.0);
}
float clampf2(float v, float lo, float hi) { return v < lo ? lo : (v > hi ? hi : v); }
float cellErr(int idx) { return gridCDF[idx] - (idx > 0 ? gridCDF[idx - 1] : 0.0); }

void main() {
    int k = int(gl_GlobalInvocationID.x);
    if (k >= pc.K) return;
    uint ctr = 0u;
    float total = gridCDF[pc.gw * pc.gh - 1];
    float cx, cy;
    if (total <= 0.0) { cx = uf(uint(k), ctr) * float(pc.W); cy = uf(uint(k), ctr) * float(pc.H); }
    else {
        float u = uf(uint(k), ctr) * total;
        int lo = 0, hi = pc.gw * pc.gh - 1;
        while (lo < hi) { int mid = (lo + hi) >> 1; if (gridCDF[mid] < u) lo = mid + 1; else hi = mid; }
        int gx = lo % pc.gw, gy = lo / pc.gw;
        int x0 = gx * pc.W / pc.gw, x1 = (gx + 1) * pc.W / pc.gw, y0 = gy * pc.H / pc.gh, y1 = (gy + 1) * pc.H / pc.gh;
        if (x1 <= x0) x1 = x0 + 1; if (y1 <= y0) y1 = y0 + 1;
        cx = float(x0) + uf(uint(k), ctr) * float(x1 - x0);
        cy = float(y0) + uf(uint(k), ctr) * float(y1 - y0);
    }
    cx = clampf2(cx, 0.0, float(pc.W - 1)); cy = clampf2(cy, 0.0, float(pc.H - 1));
    float capR = pc.maxR;
    if (pc.hasBound != 0 && pc.boundMix > 0.0) {
        int bidx = int(cy) * pc.W + int(cx);
        if (bidx >= 0 && bidx < pc.W * pc.H) { float lim = boundDist[bidx] + pc.boundPad; if (lim < capR) capR = capR + (lim - capR) * pc.boundMix; }
    }
    // momentFitDevice
    float sx = float(pc.W) / float(pc.gw), sy = float(pc.H) / float(pc.gh);
    int gcx = int(cx / sx), gcy = int(cy / sy);
    int rcx = int(capR / sx) + 1, rcy = int(capR / sy) + 1;
    int gx0 = max(gcx - rcx, 0), gy0 = max(gcy - rcy, 0), gx1 = min(gcx + rcx, pc.gw - 1), gy1 = min(gcy + rcy, pc.gh - 1);
    REAL m00 = REAL(0.0), m10 = REAL(0.0), m01 = REAL(0.0);
    for (int gy = gy0; gy <= gy1; gy++) for (int gx = gx0; gx <= gx1; gx++) {
        int idx = gy * pc.gw + gx; float e = cellErr(idx); if (e <= 0.0) continue;
        m00 += REAL(e); m10 += REAL(gx) * REAL(e); m01 += REAL(gy) * REAL(e);
    }
    float scx, scy, srx, sry, sth; int valid = 1;
    if (m00 <= REAL(1e-9)) { valid = 0; }
    else {
        REAL mcx = m10 / m00, mcy = m01 / m00;
        REAL u20 = REAL(0.0), u02 = REAL(0.0), u11 = REAL(0.0);
        for (int gy = gy0; gy <= gy1; gy++) for (int gx = gx0; gx <= gx1; gx++) {
            int idx = gy * pc.gw + gx; float e = cellErr(idx); if (e <= 0.0) continue;
            REAL dx = REAL(gx) - mcx, dy = REAL(gy) - mcy;
            u20 += REAL(e) * dx * dx; u02 += REAL(e) * dy * dy; u11 += REAL(e) * dx * dy;
        }
        u20 /= m00; u02 /= m00; u11 /= m00;
        // Cell -> pixel: the grid is gw x gh whatever the image aspect, so a cell is sx by sy
        // and the covariance must be mapped (S*Sigma*S^T) before it is decomposed. Scaling the
        // axes by (sx+sy)/2 afterwards reports both the wrong aspect and the wrong angle;
        // that is what pc.aniso == 0 (FH6_GRIDASPECT=0) restores -- an isotropic covariance
        // scale leaves the eigenvectors alone, so it is exactly the old "* s" on the axes.
        // The pin keeps the whole scale on the AXES, where it used to be, so it stays
        // bit-identical -- scaling a covariance by exactly 1 is exact.
        float mx = 1.0, my = 1.0, post = 1.0;
        if (pc.aniso != 0) { mx = sx; my = sy; } else { post = (sx + sy) / 2.0; }
        u20 *= REAL(mx) * REAL(mx); u02 *= REAL(my) * REAL(my); u11 *= REAL(mx) * REAL(my);
        REAL hlf = (u20 - u02) / REAL(2.0);
        REAL d = REAL(sqrt(float(max(REAL(0.0), hlf * hlf + u11 * u11))));
        REAL lmax = (u20 + u02) / REAL(2.0) + d, lmin = (u20 + u02) / REAL(2.0) - d; if (lmin < REAL(0.0)) lmin = REAL(0.0);
        REAL major = REAL(2.0) * REAL(sqrt(float(lmax))), minor = REAL(2.0) * REAL(sqrt(float(lmin)));
        scx = float((mcx + REAL(0.5)) * REAL(sx)); scy = float((mcy + REAL(0.5)) * REAL(sy));
        srx = float(max(major, REAL(0.5)) * REAL(post)); sry = float(max(minor, REAL(0.5)) * REAL(post));
        // atan(0,0) is undefined in GLSL and a single hot cell makes both arguments exactly zero
        // (u11 = 0 and u20 == u02), so the orientation of an isolated seed was whatever the driver
        // returned — NaN on some, 0 on others, and the candidate pool differed by vendor.
        float ay = float(REAL(2.0) * u11), ax = float(u20 - u02);
        sth = (ay == 0.0 && ax == 0.0) ? 0.0 : 0.5 * atan(ay, ax) * 57.295779513082323;
    }
    if (valid == 0) { scx = cx; scy = cy; srx = max(4.0, capR * 0.3); sry = srx; sth = uf(uint(k), ctr) * 360.0; }
    int base = k * 6;
    seeds[base + 0] = scx; seeds[base + 1] = scy; seeds[base + 2] = srx; seeds[base + 3] = sry; seeds[base + 4] = sth; seeds[base + 5] = capR;
}
