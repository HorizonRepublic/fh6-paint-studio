#version 450
#ifdef FH6_FP32
#define REAL float
#define RVEC3 vec3
#else
#extension GL_ARB_gpu_shader_fp64 : require
#define REAL double
#define RVEC3 dvec3
#endif
// polish_loss.comp — weighted SSE of render vs target, reduced in REAL. Each of the
// G workgroups strides its share of pixels (fixed-order, deterministic), writes one
// partial; the host sums the G partials. Mirrors engine.polishLoss.
// pc.oklab = the perceptual variant: w*(dL^2+da^2+db^2+dalpha^2) in OKLab (engine.okLabPixelLoss).

layout(local_size_x = 128) in;
layout(std430, binding = 3) readonly  buffer Rb { float render[]; };
layout(std430, binding = 7) writeonly buffer Lb { REAL partials[]; };
layout(std430, binding = 8) readonly  buffer Tb { float target[]; };
layout(std430, binding = 9) readonly  buffer Wb { float weightb[]; };
layout(push_constant) uniform PC {
    int shapeIdx, w, h, xMin, yMin, xMax, yMax, boff, ste, npix; float tau; int oklab;
} pc;

shared REAL sh[128];

// dcbrt — REAL cube root: GLSL fp64 has no transcendental builtins, so seed from the
// float pow and Newton-refine twice in REAL (~1e-15 rel, golden-diff-tight vs math.Cbrt).
REAL dcbrt(REAL x) {
    if (x < 1e-30) return REAL(0.0);
    REAL c = REAL(pow(float(x), 0.33333334));
    c -= (c * c * c - x) / (REAL(3.0) * c * c);
    c -= (c * c * c - x) / (REAL(3.0) * c * c);
    return c;
}

// toOKLab — OKLab from the linear working space (mirrors engine.linearToOKLab).
RVEC3 toOKLab(REAL r, REAL g, REAL b) {
    REAL l = REAL(0.4122214708) * r + REAL(0.5363325363) * g + REAL(0.0514459929) * b;
    REAL m = REAL(0.2119034982) * r + REAL(0.6806995451) * g + REAL(0.1073969566) * b;
    REAL s = REAL(0.0883024619) * r + REAL(0.2817188376) * g + REAL(0.6299787005) * b;
    REAL lc = dcbrt(l), mc = dcbrt(m), sc = dcbrt(s);
    return RVEC3(REAL(0.2104542553) * lc + REAL(0.7936177850) * mc - REAL(0.0040720468) * sc,
                 REAL(1.9779984951) * lc - REAL(2.4285922050) * mc + REAL(0.4505937099) * sc,
                 REAL(0.0259040371) * lc + REAL(0.7827717662) * mc - REAL(0.8086757660) * sc);
}

void main() {
    uint lid = gl_LocalInvocationID.x;
    int stride = int(gl_NumWorkGroups.x * gl_WorkGroupSize.x);
    REAL acc = REAL(0.0);
    for (int idx = int(gl_GlobalInvocationID.x); idx < pc.npix; idx += stride) {
        REAL wt = REAL(weightb[idx]);
        int p = idx * 4;
        if (pc.oklab != 0) {
            RVEC3 rl = toOKLab(REAL(render[p]), REAL(render[p + 1]), REAL(render[p + 2]));
            RVEC3 tl = toOKLab(REAL(target[p]), REAL(target[p + 1]), REAL(target[p + 2]));
            RVEC3 d3 = rl - tl;
            REAL dAl = REAL(render[p + 3]) - REAL(target[p + 3]);
            acc += wt * (d3.x * d3.x + d3.y * d3.y + d3.z * d3.z + dAl * dAl);
            continue;
        }
        for (int c = 0; c < 4; c++) {
            REAL d = REAL(render[p + c]) - REAL(target[p + c]);
            acc += wt * d * d;
        }
    }
    sh[lid] = acc;
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1) {
        if (lid < s) sh[lid] += sh[lid + s];
        barrier();
    }
    if (lid == 0u) partials[gl_WorkGroupID.x] = sh[0];
}
